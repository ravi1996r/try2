# =============================================================================
# Ravi 3D Portfolio - configuration reference
# =============================================================================
# HOW TO USE
#   PowerShell :  Copy-Item .env.example .env
#   bash       :  cp .env.example .env
# Then edit only what you need. EVERYTHING here has a working default, so an unedited copy boots
# the whole site on local backends with NO credentials.
#
# RULES HONOURED BY THIS FILE
#   * Every variable the code reads MUST appear here (enforced by test-env-example-drift).
#   * Every variable here is read by the code (enforced by the same test, other direction).
#   * Only names and safe placeholders. Never commit a real value.
#   * Secrets are server-side only; nothing server-side is ever sent to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. GLOBAL SWITCHES  (needed: local + production)
# -----------------------------------------------------------------------------

# local | production. In production, startup REFUSES to run if any concern resolves to a local
# engine or a fake provider, unless PORTFOLIO_ALLOW_LOCAL_BACKENDS_IN_PRODUCTION=true.
APP_ENV=local

# true | false. An explicit startup choice, NOT a runtime failover: if a production backend goes
# down we report it; we never silently swap in a local engine.
USE_LOCAL_FALLBACKS=true

# Escape hatch for the production guard. Leave false unless you understand that it lets
# production run on local engines: fine for a demo, wrong for real traffic.
PORTFOLIO_ALLOW_LOCAL_BACKENDS_IN_PRODUCTION=false

# debug | info | warn | error. Never logs prompts, uploaded content or secrets.
PORTFOLIO_LOG_LEVEL=info

# Telemetry. Off unless configured. Personal resource preferred.
#   local: no   production: optional
PORTFOLIO_TELEMETRY_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=


# -----------------------------------------------------------------------------
# 2. SERVICE ADDRESSES  (needed: local + production)
# -----------------------------------------------------------------------------

# The site's own origin, used for CORS allow-listing. No trailing slash.
SITE_ORIGIN=http://localhost:5173

# Node gateway (BFF). The browser only ever talks to this.
GATEWAY_HOST=127.0.0.1
# -----------------------------------------------------------------------------
# 3. DATA LAYER SELECTORS  (needed: local + production)
# -----------------------------------------------------------------------------
# Each selector overrides the APP_ENV/USE_LOCAL_FALLBACKS default for one concern only.
# Business logic depends on the interface, never on these values.

# sqlite | mongodb
DB_BACKEND=sqlite

# memory | disk | redis
CACHE_BACKEND=memory

# local (numpy flat index + SQLite FTS5) | azure_search
#   chroma and faiss are Not Implemented. See docs/16-local-first-backends.md for why the local
#   engine is a dependency-free flat index rather than an embedded vector database.
VECTOR_BACKEND=local

# local | azure_blob
BLOB_BACKEND=local

# Where SQLite, indexes, blobs and caches live. MUST be outside any served directory.
# Never point this at apps/web/public: data/ must never be reachable over HTTP.
PORTFOLIO_DATA_DIR=./data


# -----------------------------------------------------------------------------
# 4. LLM - SITE PATH  (needed: for chat)
# -----------------------------------------------------------------------------
# The SITE PATH model is the default model used on the visitor's behalf. Its key is server-side
# only and is NEVER sent to the browser.

# openrouter | openai_compatible | azure_openai
#   openrouter         : all site-path LLM traffic via https://openrouter.ai/api/v1
#   openai_compatible : keyless, for a local Ollama / LM Studio / llama.cpp server
#   azure_openai      : production default
LLM_PROVIDER=openrouter

# --- OpenRouter (local/dev default for the site model) ---
# SERVER-ONLY. Leave blank to boot with no credentials: chat then reports
# "Site model unavailable: no model configured" and opens the model switcher.
OPENROUTER_API_KEY=
# Model id from env, never hard-coded in source.
OPENROUTER_MODEL=

# --- Local OpenAI-compatible server (keyless alternative) ---
# Ollama  http://127.0.0.1:11434/v1    LM Studio  http://127.0.0.1:1234/v1
# Use with LLM_PROVIDER=openai_compatible. Port 8080 is this project's AI service, so do NOT run
# a llama.cpp server there; 8081 is the documented suggestion.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Azure OpenAI (production) ---
# SERVER-ONLY. Personal resource only. See docs/13-deployment-and-cost.md for the policy warning
# about using employer-owned resources for a public personal site.
AZURE_OPENAI_ENDPOINT=
# -----------------------------------------------------------------------------
# 5. EMBEDDINGS  (needed: for Drop-Zone)
# -----------------------------------------------------------------------------
# Embeddings, ingestion and retrieval ALWAYS run server-side on the configured backend, even when
# a visitor switches the answering model to their own provider.

# local | azure_openai
#   local : deterministic in-process embedder, no key and no model download. Labelled
#           EXPERIMENTAL on purpose: it is a hashed bag-of-terms vector, good for lexical-ish
#           similarity at this data size and NOT a substitute for a trained sentence encoder.
#           See docs/providers.md.
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
EMBEDDING_MODEL_ID=local-hashed-ngram-v1

# The index records the embedder id and dimension it was built with. A mismatch fails fast and
# points at `npm run index:rebuild`.


# -----------------------------------------------------------------------------
# 6. WEB SEARCH  (needed: for Drop-Zone "sources + web")
# -----------------------------------------------------------------------------
# Two adapters behind ONE interface. No silent switching: if the selected adapter fails, the
# visitor sees a search outage, never invented or empty results.

# ddg | brave | none
#   ddg   : DuckDuckGo via the ddgs library. NO API KEY, but UNOFFICIAL scraping. EXPERIMENTAL.
#           Not suitable as the only provider for a public site.
#   brave : Brave Search API. The recommended OFFICIAL option for any public deployment.
#   none  : Web mode disabled, with a visible reason.
PORTFOLIO_SEARCH_PROVIDER=ddg
PORTFOLIO_SEARCH_API_KEY=
PORTFOLIO_SEARCH_MAX_RESULTS=5
# Per-session cap on outbound web queries. Cost control, not politeness.
PORTFOLIO_SEARCH_MAX_QUERIES_PER_SESSION=8
# How long a search result set is cached (seconds). Short, because web results go stale.
PORTFOLIO_SEARCH_CACHE_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# 7. RATE LIMITS, BUDGET AND SESSIONS  (needed: local + production)
# -----------------------------------------------------------------------------
# Cost and abuse protection. Enforced identically in local mode so local matches production.

PORTFOLIO_RATE_LIMIT_PER_IP_PER_MINUTE=20
PORTFOLIO_RATE_LIMIT_PER_SESSION_PER_MINUTE=30
PORTFOLIO_DAILY_TOKEN_BUDGET=200000
PORTFOLIO_REQUEST_MAX_BYTES=65536
PORTFOLIO_HISTORY_MAX_MESSAGES=12

# Short-term memory TTL for conversation context. Disclosed in the UI: conversations are not
# persisted by default, and this is how long the rolling context survives.
PORTFOLIO_SESSION_TTL_SECONDS=1800

# Optional bot challenge (Turnstile) before chat.
#   local: no   production: optional
PORTFOLIO_BOT_CHALLENGE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
AZURE_OPENAI_API_KEY=
# -----------------------------------------------------------------------------
# 8. MODEL SWITCHER / CSP  (needed: local + production)
# -----------------------------------------------------------------------------

# connect-src policy for visitor-chosen providers. Default: 'self' + known provider hosts +
# loopback only, so a Custom endpoint can only be a local server.
# Setting this true widens connect-src to ANY https endpoint: a real trade-off, because it lets a
# visitor point the browser at an arbitrary host. Documented in docs/15-model-switcher.md.
PORTFOLIO_ALLOW_ANY_HTTPS_ENDPOINT=false

# CSP for the site itself. script-src stays strict regardless (no inline, no third-party scripts).
PORTFOLIO_CSP_SCRIPT_SRC='self'
PORTFOLIO_CSP_STYLE_SRC='self'

# Where the fake providers listen in tests/CI. They refuse to start when APP_ENV=production.
FAKE_PROVIDERS_PORT=8090
FAKE_PROVIDERS_OLLAMA_PORT=8091
FAKE_PROVIDERS_ANTHROPIC_PORT=8092
FAKE_PROVIDERS_GEMINI_PORT=8093
FAKE_PROVIDERS_SEARCH_PORT=8094


# -----------------------------------------------------------------------------
# 9. PRODUCTION DATA BACKENDS  (production only - leave blank locally)
# -----------------------------------------------------------------------------
# Classification is in docs/00-plan.md. USE = may be used when that selector is chosen.
# OPTIONAL = only if that optional integration is implemented. DO NOT USE = never.

# --- MongoDB (DB_BACKEND=mongodb) ---
# USE only if justified (docs/14-decision-log.md). Collections are prefixed portfolio_.
MONGODB_URI=
MONGODB_DB=portfolio

# --- Redis (CACHE_BACKEND=redis) ---
# Keys are prefixed portfolio:{env}: so this project never touches another project's data. USE.
REDIS_URL=
REDIS_KEY_PREFIX=portfolio:local

# --- Azure AI Search (VECTOR_BACKEND=azure_search) ---
# USE, own indexes only. Indexes are prefixed portfolio-.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=portfolio-content

# --- Azure Blob Storage (BLOB_BACKEND=azure_blob) --- USE.
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=portfolio-blobs


# -----------------------------------------------------------------------------
# 10. DROP-ZONE LIMITS  (needed: local + production)
# -----------------------------------------------------------------------------
# Enforced identically in local mode. Content is validated BY MAGIC BYTES, never by extension.

PORTFOLIO_DROPZONE_MAX_FILES=5
PORTFOLIO_DROPZONE_MAX_FILE_BYTES=10485760
PORTFOLIO_DROPZONE_MAX_TOTAL_PAGES=100
PORTFOLIO_DROPZONE_MAX_URL_FETCHES=5
PORTFOLIO_DROPZONE_URL_TIMEOUT_SECONDS=10
PORTFOLIO_DROPZONE_URL_MAX_RESPONSE_BYTES=5242880
PORTFOLIO_DROPZONE_URL_MAX_REDIRECTS=3
PORTFOLIO_DROPZONE_IDLE_TTL_SECONDS=1800
PORTFOLIO_DROPZONE_MAX_CONTEXT_TOKENS=6000


# -----------------------------------------------------------------------------
# 11. TESTING AND LIVE RUNS
# -----------------------------------------------------------------------------

# Guard for anything that spends real money or touches a real cloud resource.
# test:live and evals:live refuse to run unless this is exactly 1.
ALLOW_LIVE_TESTS=0

# Hard caps enforced in code and printed in the report. test:live / evals:live stop here.
PORTFOLIO_LIVE_MAX_REQUESTS=20
PORTFOLIO_LIVE_MAX_TOKENS=20000

# Optional real-provider keys for live adapter tests. Absent => those tests report
# "skipped (no key)" explicitly and are listed in the Phase Report.
PORTFOLIO_TEST_OPENAI_API_KEY=
PORTFOLIO_TEST_ANTHROPIC_API_KEY=
PORTFOLIO_TEST_GEMINI_API_KEY=
# Base URL of a running local Ollama/LM Studio, for the local live path.
PORTFOLIO_TEST_OLLAMA_BASE_URL=http://127.0.0.1:11434


# -----------------------------------------------------------------------------
# 12. DELIBERATELY IGNORED (denylist) - documented for completeness
# -----------------------------------------------------------------------------
# The config loader ignores and NEVER logs any variable whose name contains SERVICENOW,
# NEXTTHINK, ADF, DIRECTLINE or MICROSOFT-APP. These belong to employer work, not to this site:
#
#   SERVICENOW_*       DO NOT USE  (employer ITSM / ticketing)
#   NEXTTHINK_*        DO NOT USE  (employer)
#   ADF_*              DO NOT USE  (employer data-factory pipelines)
#   DIRECTLINE_*       DO NOT USE  (Bot Framework / Direct Line keys not needed)
#   MICROSOFT-APP_*    DO NOT USE  (employer app registration)
#
# A test asserts these are never read and never appear in logs.
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=portfolio-embeddings

LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=800
# Token budget for assembled context per turn. Truncates old turns rather than failing.
PORTFOLIO_CONTEXT_TOKEN_BUDGET=6000
GATEWAY_PORT=8082

# Python AI service. Internal only: never expose publicly.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8080
AI_SERVICE_BASE_URL=http://127.0.0.1:8080

# Shared secret for gateway -> AI service calls (short-lived tokens are derived from it).
# SERVER-ONLY. The local default is deliberately a placeholder, not a real credential, so the
# project boots with zero credentials. In production set a long random value (32+ bytes).
# Key Vault style mapping: portfolio-internal-service-auth -> PORTFOLIO_INTERNAL_SERVICE_AUTH
PORTFOLIO_INTERNAL_SERVICE_AUTH=local-development-placeholder-not-a-secret
PORTFOLIO_INTERNAL_SERVICE_AUTH_TTL_SECONDS=300

# Signs the session cookie so a client cannot forge or read another visitor's session.
# SERVER-ONLY. Same local/production treatment as the value above.
PORTFOLIO_SESSION_SECRET=local-development-placeholder-not-a-secret