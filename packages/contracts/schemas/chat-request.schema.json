{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://portfolio.local/schemas/chat-request.json",
  "title": "ChatRequest",
  "description": "Browser -> gateway chat request. Also the internal gateway -> AI service body (plus headers).",
  "type": "object",
  "required": ["bot", "message"],
  "properties": {
    "bot": { "enum": ["bot1", "bot2", "bot3"] },
    "session_id": { "type": "string", "maxLength": 128 },
    "message": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "history": {
      "type": "array",
      "maxItems": 40,
      "description": "Browser path only. Size-capped and treated as UNTRUSTED input.",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "content": { "type": "string", "maxLength": 8000 }
        },
        "additionalProperties": false
      }
    },
    "capabilities": { "$ref": "#/definitions/capability_profile" },
    "context_window": { "type": "integer", "minimum": 512, "maximum": 1000000 },
    "search_scope": {
      "enum": ["sources_only", "sources_and_web"],
      "description": "Bot 2 only. sources_only MUST NOT call any web search adapter."
    },
    "path": { "enum": ["site", "browser"] },
    "requested_max_tokens": { "type": "integer", "minimum": 16, "maximum": 4096 }
  },
  "additionalProperties": false,

  "definitions": {
    "capability_profile": {
      "type": "object",
      "description": "Recorded by the Test & switch probe in the browser.",
      "properties": {
        "context_tokens": { "type": "integer", "minimum": 0 },
        "tools": { "type": "boolean" },
        "json_mode": { "type": "boolean" },
        "vision": { "type": "boolean" },
        "streaming": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}